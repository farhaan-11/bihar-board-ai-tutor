# Core
PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/bihar_board_ai_tutor?retryWrites=true&w=majority&appName=Cluster0
FRONTEND_URL=http://localhost:5173

# LLM — currently active in this project: openai (Groq is disabled due to 429 rate limits, see CLAUDE.md)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0

# Decider (intent classifier) — optional, defaults to LLM_PROVIDER/LLM_MODEL above if unset.
# Lets the decider run on a separate (e.g. cheaper/faster) model from the main tutor response.
DECIDER_PROVIDER=openai
DECIDER_MODEL=gpt-4o-mini

GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Embeddings — currently active: openai. See backend/src/rag/geminiEmbeddings.js.
EMBEDDING_PROVIDER=openai
# Query-time-only fallback to Gemini if OpenAI is down. Never used at indexing time.
EMBEDDING_FALLBACK_ENABLED=true
GEMINI_API_KEY=your_gemini_api_key_here

# Auth — JWT
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Guest identity token — signs the server-minted guest tokens that replace
# client-generated guest ids (see src/auth/guestTokenHelpers.js). Keep separate
# from the JWT secrets above. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GUEST_TOKEN_SECRET=your_guest_token_secret_here

# Redis — used for both Auth (JWT sessions) AND Caching (embedding + retrieval results)
# Get a free Upstash Redis at https://upstash.com — free tier is sufficient for this project
# If not set: system still works, caching falls back to in-memory only (no cross-restart persistence)
REDIS_URL=rediss://default:your_upstash_token@your_upstash_endpoint:6379

# Auth — Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5001/api/v1/auth/google/callback

# Auth — Email (Nodemailer). See PRE_LAUNCH_BLOCKERS.md P1 for a pending migration to Resend API
# (Render blocks outbound SMTP ports on its free tier).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email_here
EMAIL_PASS=your_email_app_password_here
EMAIL_FROM=Zuno <noreply@zuno.com>

# Auth — Bcrypt
BCRYPT_SALT_ROUNDS=12

# Query limits
GUEST_DAILY_LIMIT=5
USER_DAILY_LIMIT=20

# Guest turn limit — guests can ask this many questions before being asked to log in (default 5)
GUEST_TURN_LIMIT=5

# Session token limit — session locks when totalTokensUsed reaches this value
SESSION_TOKEN_LIMIT=15000

# Intent Router — set true to use intent-specific prompts instead of monolithic tutorPrompt.
# Default false = legacy path active. Set true only after running the golden test set (npm run test:golden).
USE_INTENT_ROUTER=false

# Drift guard — max casual/off-topic turns before hard block per session (default 10).
# Set lower (e.g. 3) for testing. Math.max(1,...) in env.js prevents 0 or negative values.
MAX_NON_ACADEMIC_TURNS=10

# Python retrieval service (zuno-retrieval-service) — see backend/src/rag/pythonRetrieverClient.js
# false (default) = Node retriever only | shadow = Node answers, Python only logged | true = Python answers
# URL: no trailing slash and no /retrieve (the client adds it). KEY: must equal INTERNAL_API_KEY of the Python service.
USE_PYTHON_RETRIEVER=false
PYTHON_RETRIEVER_URL=http://localhost:8000
INTERNAL_API_KEY=
